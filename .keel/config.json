        "docs/control-plane/ENVIRONMENTS.md",
        "docs/control-plane/KEEL_PARALLEL.md"
      ],
      "infra-iac": [
        "docs/control-plane/ENVIRONMENTS.md",
        "docs/control-plane/SECURITY_DATA_SUPPLY_CHAIN.md"
      ],
      "migrations-backup-dr": [
        "policies/templates/RELEASE.md"
      ],
      "ml-data-agent-evals": [
        "docs/control-plane/FEEDBACK_EVALS.md"
      ],
      "observability": [
        "docs/control-plane/OPERABILITY.md"
      ],
      "privacy-data": [
        "docs/control-plane/SECURITY_DATA_SUPPLY_CHAIN.md"
      ],
      "quality-static-analysis": [
        "docs/control-plane/ARCHITECTURE_ENFORCEMENT.md"
      ],
      "release-deploy-rollback": [
        "policies/templates/RELEASE.md"
      ],
      "reliability-slos": [
        "policies/templates/RELIABILITY.md"
      ],
      "security": [
        "policies/templates/SECURITY.md",
        "docs/control-plane/SECURITY_DATA_SUPPLY_CHAIN.md"
      ],
      "testing-evals": [
        "docs/control-plane/TESTING_CI_GENERATED.md",
        "docs/control-plane/VERIFICATION.md"
      ],
      "ui-browser-a11y-i18n": [
        "policies/templates/FRONTEND.md",
        "docs/control-plane/VERIFICATION.md"
      ]
    },
    "max_chars": 12000
  },
  "contracts_file": ".keel/contracts.json",
  "hook_summary_max_chars": 6000,
  "max_agents_cascade_bytes": 32768,
  "root_agents_max_lines": 100,
