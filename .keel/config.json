{
  "capability_resolver": {
    "ignore_dirs": [
      "node_modules",
      "vendor",
      "dist",
      "build",
      "target",
      ".venv",
      "venv"
    ],
    "max_evidence_per_capability": 12
  },
  "context_compiler": {
    "always_docs": [
      "AGENTS.md",
      "WORKFLOW.md",
      "docs/control-plane/KEEL.md",
      "docs/control-plane/VERIFICATION.md"
    ],
    "capability_docs": {
      "architecture-boundaries": [
        "ARCHITECTURE.md",
        "docs/control-plane/ARCHITECTURE_ENFORCEMENT.md"
      ],
      "build-toolchain": [
        "docs/control-plane/COMMANDS.md"
      ],
      "environments-worktrees": [
        "docs/control-plane/ENVIRONMENTS.md",
        "docs/control-plane/KEEL_PARALLEL.md"
      ],
      "infra-iac": [
        "docs/control-plane/ENVIRONMENTS.md",
        "docs/control-plane/SECURITY_DATA_SUPPLY_CHAIN.md"
      ],
      "migrations-backup-dr": [
        "docs/control-plane/RELEASE_OPERATIONS.md"
      ],
      "ml-data-agent-evals": [
        "docs/control-plane/FEEDBACK_EVALS.md"
      ],
      "observability": [
        "docs/control-plane/OPERABILITY.md"
      ],
      "privacy-data": [
        "docs/control-plane/SECURITY_DATA_SUPPLY_CHAIN.md"
      ],
      "quality-static-analysis": [
        "docs/control-plane/ARCHITECTURE_ENFORCEMENT.md"
      ],
      "release-deploy-rollback": [
        "docs/control-plane/RELEASE_OPERATIONS.md"
      ],
      "reliability-slos": [
        "docs/RELIABILITY.md"
      ],
      "security": [
        "docs/SECURITY.md",
        "docs/control-plane/SECURITY_DATA_SUPPLY_CHAIN.md"
      ],
      "testing-evals": [
        "docs/control-plane/TESTING_CI_GENERATED.md",
        "docs/control-plane/VERIFICATION.md"
      ],
      "ui-browser-a11y-i18n": [
        "docs/FRONTEND.md",
        "docs/control-plane/VERIFICATION.md"
      ]
    },
    "max_chars": 12000
  },
  "contracts_file": ".keel/contracts.json",
  "hook_summary_max_chars": 6000,
  "max_agents_cascade_bytes": 32768,
  "root_agents_max_lines": 100,
  "schema_version": 2,
  "source_classification": {
    "explicit_non_source_globs": [],
    "explicit_source_globs": []
  },
  "verification_commands": [
    {
      "argv": [
        "python",
        ".keel/bin/keel.py",
        "doctor"
      ],
      "cwd": ".",
      "id": "control-plane-doctor",
      "required": true,
      "timeout_sec": 120
    },
    {
