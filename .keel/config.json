      "authority": "INSPECTED",
      "id": "control-plane-doctor",
      "mandatory_kernel": true,
      "provenance": ".keel/config.json",
      "provider": "command",
      "runtime": {
        "argv": [
          "python",
          ".keel/bin/keel.py",
          "doctor"
        ],
        "cwd": ".",
        "kind": "command",
        "timeout_sec": 120
      },
      "supports": {
        "evidence_providers": [
          "command",
          "command"
        ],
        "requirement_types": [
          "behavior",
          "quality",
          "security",
          "migration",
          "performance",
          "architecture",
          "documentation"
        ]
      },
      "version": "1"
