{
  "capability_resolver": {
    "ignore_dirs": [
      "node_modules",
      "vendor",
      "dist",
      "build",
      "target",
      ".venv",
      "venv"
    ],
    "max_evidence_per_capability": 12
  },
  "context_compiler": {
    "always_docs": [
      "AGENTS.md",
      "WORKFLOW.md",
      "docs/control-plane/KEEL.md",
      "docs/control-plane/VERIFICATION.md"
    ],
