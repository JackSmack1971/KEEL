# Codex-native prompts are an outer runtime guardrail, not KEEL lifecycle policy or
# a CapabilityGrant. Deterministic repository decisions come from the KEEL kernel.
prefix_rule(
    pattern=["git", ["reset", "clean"]],
    decision="prompt",
    justification="Destructive local Git effects require explicit Codex review in addition to any KEEL decision.",
    match=["git reset --hard", "git clean -fd"],
    not_match=["git status", "git diff"],
)

prefix_rule(
    pattern=["git", "push", ["--force", "-f"]],
    decision="prompt",
    justification="Remote history rewriting remains externally consequential regardless of KEEL lifecycle eligibility.",
    match=["git push --force origin main", "git push -f origin feature"],
    not_match=["git push origin feature", "git push --force-with-lease origin feature"],
)
